# Lightweight boot-path smoke image (NO CUDA, NO real Comfy, NO real weights).
# Validates entrypoint + start.sh + MODEL_DIR/weights layout + mock Comfy ready.
#
# Build (from monorepo root OR this directory — see tools/local_boot_smoke.sh):
#   docker build -f workers/minimax_h3_comfy/Dockerfile.bootcheck \
#     -t minimax-h3-bootcheck workers/minimax_h3_comfy

FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    COMFYUI_PATH=/comfyui \
    COMFY_URL=http://127.0.0.1:8188 \
    COMFY_OUTPUT_DIR=/comfyui/output \
    MODEL_DIR=/runpod-volume/minimax_h3_comfy \
    BOOT_CHECK=1 \
    BOOT_FAIL_SLEEP=0

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    coreutils \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/local/bin/python3 /usr/local/bin/python

# Fake Comfy tree
RUN mkdir -p /comfyui/output
COPY tools/mock_comfy_main.py /comfyui/main.py

WORKDIR /app
COPY entrypoint.sh start.sh /app/
# handler/workflow not required for BOOT_CHECK=1 (start.sh exits before handler)
RUN chmod +x /app/entrypoint.sh /app/start.sh \
    && sed -i 's/\r$//' /app/entrypoint.sh /app/start.sh

CMD ["/bin/bash", "/app/entrypoint.sh"]
